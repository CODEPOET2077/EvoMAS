# Copy this file to `.env` and fill in the keys you need.
PYTHONWARNINGS=ignore
ANONYMIZED_TELEMETRY=false

# OpenAI (GPT-4o / GPT-4o-mini / GPT-4.1, used by the default configs)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=xxxxxx

# Anthropic (optional)
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_API_KEY=xxxxxx

# Google Gemini (optional, e.g. gemini-2.5-pro)
GOOGLE_API_KEY=xxxxxx
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Optional OpenAI-compatible endpoint (e.g. a local vLLM server)
# LOCAL_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# LOCAL_MODEL_NAME=qwen2.5-7b-instruct
# LOCAL_API_BASE=http://localhost:8000/v1
# LOCAL_API_KEY=EMPTY

# Web search (web_searcher_tool; default engine is Firecrawl)
FIRECRAWL_API_KEY=xxxxxx
# SERPAPI_API_KEY=xxxxxx   # for engine="Google"

# Optional HTTP proxy for outgoing requests
# LOCAL_PROXY_BASE=http://localhost:7890
